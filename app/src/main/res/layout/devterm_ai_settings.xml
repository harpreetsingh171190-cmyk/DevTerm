<LinearLayout
xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="vertical"
android:padding="16dp">


<EditText
android:id="@+id/openAIKey"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:hint="OpenAI API Key"/>


<EditText
android:id="@+id/claudeKey"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:hint="Claude API Key"/>


<EditText
android:id="@+id/geminiKey"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:hint="Gemini API Key"/>


<EditText
android:id="@+id/ollamaURL"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:hint="Ollama URL"
android:text="http://127.0.0.1:11434"/>


<Button
android:id="@+id/saveAISettings"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:text="💾 Save AI Settings"/>

</LinearLayout>
